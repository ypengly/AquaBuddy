# SQLite for local development (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Web Push (generate with: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Protects /api/cron/reminders (use a long random string)
CRON_SECRET=""
